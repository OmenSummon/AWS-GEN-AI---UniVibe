# UniVibe Environment Configuration

# Next.js Public Settings
NEXT_PUBLIC_APP_NAME="UniVibe"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (Neon Serverless PostgreSQL)
# Paste your Neon DB connection string here (e.g. postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require)
# If not configured, UniVibe automatically runs in resilient Demo Mode with local state persistence
DATABASE_URL=""

# AI Provider Configuration ("bedrock" | "simulated")
# Leave as simulated or empty to run in honest Demo Mode with realistic responses
AI_PROVIDER="simulated"

# AWS Bedrock Configuration
# Required when AI_PROVIDER="bedrock"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BEDROCK_TEXT_MODEL_ID="anthropic.claude-3-5-sonnet-20240620-v1:0"
AWS_BEDROCK_IMAGE_MODEL_ID="bedrock-stability.stable-image-core-v1-1"

# Supabase Authentication & Storage (Optional, or use local student auth session)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
